generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  checking
  savings
  cash
  credit
  investment
  crypto
}

enum TransactionCategory {
  Income
  Expenses
  Bills
  Subscriptions
  Debts
  Savings
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  baseCurrency String   @default("EUR")
  /// Day of the month a financial month begins (1 = plain calendar months).
  /// With 29, a month runs 29 May–28 Jun and is labelled by the month it ends in,
  /// matching a pay cycle where the 29th funds the following month.
  monthStartDay Int     @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Telegram chat bound via the one-time /link code flow; null = not linked
  telegramChatId            String?   @unique
  /// sha256 hex of the pending one-time link code (single-use, short TTL)
  telegramLinkCodeHash      String?   @unique
  telegramLinkCodeExpiresAt DateTime?

  /// Account the Telegram bot books captured transactions against
  defaultAccountId String?
  defaultAccount   Account? @relation("UserDefaultAccount", fields: [defaultAccountId], references: [id], onDelete: SetNull)

  accounts            Account[]              @relation("AccountOwner")
  subcategories       Subcategory[]
  refreshTokens       RefreshToken[]
  importBatches       ImportBatch[]
  categorizationRules CategorizationRule[]
  importMappings      AccountImportMapping[]
  recurringRules      RecurringRule[]
  budgets             Budget[]
  exchangeRates       ExchangeRate[]
}

/// A user-set conversion rate from a foreign `currency` to the user's base
/// currency, effective from `date` until the next later rate. `rate` is foreign
/// units per 1 base unit (e.g. currency "KZT", rate 540 = 540 KZT per 1 EUR).
/// Transactions cache their converted value (Transaction.amountBase); changing a
/// rate recomputes the affected transactions from that date onward.
model ExchangeRate {
  id        String   @id @default(uuid())
  currency  String
  /// Calendar date this rate takes effect (UTC midnight).
  date      DateTime @db.Date
  /// Foreign units per 1 unit of the base currency.
  rate      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency, date])
  @@index([userId, currency, date])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id             String      @id @default(uuid())
  name           String
  type           AccountType
  currency       String
  /// Balance in minor currency units (cents)
  balance        Int         @default(0)
  /// Starting balance in minor currency units (cents); balance = initialBalance + sum of transaction deltas
  initialBalance Int         @default(0)
  /// `initialBalance` converted to the user's base currency (cents), frozen at the
  /// rate in effect when the account was created/edited. Used as the net-worth anchor.
  initialBalanceBase Int     @default(0)
  /// Whether this account's balance is part of the base-currency net worth. Off
  /// for a foreign "pocket" the user spends from but doesn't count as wealth
  /// (e.g. a KZT account) — its spending still counts in the stats, only the
  /// net-worth line ignores it.
  countInNetWorth Boolean    @default(true)
  /// Pinned accounts sort to the top of the accounts list, separated from the rest.
  pinned         Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  userId String
  user   User   @relation("AccountOwner", fields: [userId], references: [id])

  transactions      Transaction[]         @relation("AccountTransactions")
  incomingTransfers Transaction[]         @relation("TransferCounterAccount")
  defaultForUsers   User[]                @relation("UserDefaultAccount")
  importBatches     ImportBatch[]
  importMapping     AccountImportMapping?
  recurringRules    RecurringRule[]
  /// Rules and staged rows that treat this account as the other side of a transfer
  transferRules     CategorizationRule[]  @relation("RuleCounterAccount")
  transferRows      ImportRow[]           @relation("ImportRowCounterAccount")

  @@index([userId])
}

model Subcategory {
  id       String              @id @default(uuid())
  name     String
  category TransactionCategory
  /// Shown as a one-tap shortcut in the Telegram capture picker; the rest sit
  /// behind "More…". Ordered by name.
  pinned   Boolean             @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  transactions        Transaction[]
  rules               CategorizationRule[]
  predictedImportRows ImportRow[]          @relation("PredictedSubcategory")
  chosenImportRows    ImportRow[]          @relation("ChosenSubcategory")
  recurringRules      RecurringRule[]
  budgets             Budget[]

  @@unique([userId, name])
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  date        DateTime
  /// Amount in minor currency units (cents), always positive, in the account's currency
  amount      Int
  /// `amount` converted to the user's base currency (cents), using the exchange rate
  /// effective on `date`. Equals `amount` for base-currency accounts. All cross-account
  /// aggregations (stats, net worth, budgets) sum this so mixed currencies add up correctly.
  amountBase  Int
  description String?
  /// True for an internal move between your own accounts (a transfer leg or a
  /// currency exchange). It still moves the account balance, but is left out of
  /// income/spending/budget stats so it doesn't look like earnings or spending.
  excludeFromStats Boolean  @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  accountId String
  account   Account @relation("AccountTransactions", fields: [accountId], references: [id])

  /// Null for transfers; required for income/expense
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  /// Destination account; set only when type is TRANSFER
  counterAccountId String?
  counterAccount   Account? @relation("TransferCounterAccount", fields: [counterAccountId], references: [id])

  /// Set on an INCOME that reimburses an EXPENSE (e.g. friends paying back a shared bill)
  parentTransactionId String?
  parentTransaction   Transaction?  @relation("Reimbursements", fields: [parentTransactionId], references: [id])
  reimbursements      Transaction[] @relation("Reimbursements")

  /// sha256 of account|date|type|amount|normalizedDescription; set on imported rows so a
  /// re-uploaded statement is detected as a duplicate. Null for manually-entered rows.
  dedupeHash String?
  importRow  ImportRow?

  /// Set when this transaction was generated by a recurring rule
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([subcategoryId])
  @@index([counterAccountId])
  @@index([parentTransactionId])
  @@index([accountId, dedupeHash])
  @@index([recurringRuleId])
}

enum ImportBatchStatus {
  PENDING_REVIEW
  COMMITTED
  UNDONE
}

enum ImportRowStatus {
  /// Same dedupe hash already exists (committed or earlier in the batch)
  DUPLICATE
  /// Auto-categorized with confidence at/above the batch threshold
  READY
  /// Needs a human decision (low confidence, no prediction, or a parse error)
  NEEDS_REVIEW
  /// A transaction was created for this row on commit
  COMMITTED
  /// Excluded from the commit (duplicate or unresolved)
  SKIPPED
}

enum CategorizationSource {
  RULE
  LLM
  MANUAL
  NONE
}

/// One CSV upload. Rows are staged, categorized, reviewed, then committed as an
/// atomic (undoable) batch of transactions.
model ImportBatch {
  id          String            @id @default(uuid())
  filename    String
  status      ImportBatchStatus @default(PENDING_REVIEW)
  /// Confidence threshold used for this batch (0..1)
  threshold   Float             @default(0.7)
  /// Name of the categorization provider used (e.g. "heuristic", "anthropic")
  provider    String
  createdAt   DateTime          @default(now())
  committedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  rows ImportRow[]

  @@index([userId])
  @@index([accountId])
}

model ImportRow {
  id       String @id @default(uuid())
  rowIndex Int
  /// The raw parsed cells, keyed by header
  raw      Json

  date                  DateTime
  /// Positive minor units (cents); sign is captured by `type`
  amount                Int
  type                  TransactionType
  description           String
  normalizedDescription String
  dedupeHash            String

  status ImportRowStatus

  /// What the categorizer predicted — kept immutable for the accuracy metric
  predictedSubcategoryId String?
  predictedSubcategory   Subcategory?         @relation("PredictedSubcategory", fields: [predictedSubcategoryId], references: [id])
  confidence             Float?
  source                 CategorizationSource @default(NONE)
  /// Who made the prediction (RULE/LLM), frozen at staging. `source` tracks who
  /// decided the *final* value and is overwritten on review — without this,
  /// reviewed rows silently drop out of the accuracy metric.
  predictionSource       CategorizationSource?

  /// The effective choice (defaults to the prediction; changes when a human corrects it)
  subcategoryId String?
  subcategory   Subcategory? @relation("ChosenSubcategory", fields: [subcategoryId], references: [id])
  corrected     Boolean      @default(false)

  /// Set instead of subcategoryId when the row is a transfer between own accounts;
  /// holds the account on the other side of the movement.
  counterAccountId String?
  counterAccount   Account? @relation("ImportRowCounterAccount", fields: [counterAccountId], references: [id], onDelete: SetNull)

  /// Marked an internal move (own-account transfer / currency exchange): commits
  /// a transaction that moves the balance but is excluded from income/spending.
  excludeFromStats Boolean @default(false)

  /// Parse errors or skip reasons, surfaced in the review UI
  note String?

  /// The user's own annotation, written while reviewing ("K's birthday brunch");
  /// merged into the created transaction's description on commit. Separate from
  /// `note`, which the system overwrites with skip reasons.
  userNote String?

  /// The transaction created on commit; nulled if the batch is undone
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  batchId String
  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([dedupeHash])
}

/// A learned or user-defined merchant → subcategory mapping applied before the LLM.
/// Exactly one target is set (enforced in the service): a subcategory, or a
/// counter account meaning "matching rows are transfers between my own accounts".
model CategorizationRule {
  id        String               @id @default(uuid())
  /// Lowercased normalized substring matched against a row's normalized description
  pattern   String
  /// Which rows the rule applies to. INCOME/EXPENSE rules only match rows of
  /// that direction — the same merchant can mean different things by sign
  /// (an Amazon charge is shopping, an Amazon credit is a refund). TRANSFER
  /// rules match either direction, since money moves both ways past the same
  /// counterparty name. Derived by the service, never user-supplied.
  type      TransactionType
  source    CategorizationSource @default(MANUAL)
  hitCount  Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  /// The other side of a transfer (my other account), instead of a subcategory.
  counterAccountId String?
  counterAccount   Account? @relation("RuleCounterAccount", fields: [counterAccountId], references: [id], onDelete: Cascade)

  /// A third kind of target: matched rows are marked internal (excluded from
  /// stats) instead of getting a subcategory or transfer account.
  excludeFromStats Boolean @default(false)

  @@unique([userId, pattern, type])
  @@index([userId])
}

/// Per-account CSV column mapping, so a given bank's export format is remembered.
model AccountImportMapping {
  id                String   @id @default(uuid())
  dateColumn        String
  amountColumn      String
  descriptionColumn String
  /// e.g. "ISO", "DD.MM.YYYY", "MM/DD/YYYY", "DD/MM/YYYY"
  dateFormat        String   @default("ISO")
  decimalSeparator  String   @default(".")
  /// When true, a negative amount is an expense (the common convention)
  negativeIsExpense Boolean  @default(true)
  hasHeader         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

enum RecurringCadence {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// A rule that auto-creates a transaction on a schedule (rent, salary,
/// subscriptions, installments). A background job posts due occurrences and
/// advances the schedule; installments stop after `maxOccurrences`.
model RecurringRule {
  id                 String           @id @default(uuid())
  type               TransactionType
  /// Positive minor units (cents)
  amount             Int
  description        String?
  cadence            RecurringCadence
  /// Repeat every `interval` cadence units (e.g. every 2 weeks)
  interval           Int              @default(1)
  startDate          DateTime
  /// Next occurrence the job should create
  nextRunAt          DateTime
  /// Optional stop date (inclusive)
  endDate            DateTime?
  /// Optional installment count; the rule deactivates once this many are created
  maxOccurrences     Int?
  occurrencesCreated Int              @default(0)
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id])

  transactions Transaction[]

  @@index([userId])
  @@index([active, nextRunAt])
}

/// A spending limit for one subcategory OR one category (exactly one is set;
/// enforced in the service). `monthlyLimit` is the recurring default; a month
/// can override it via a BudgetPeriod. Progress is computed against a financial
/// month's spending in that scope.
model Budget {
  id           String   @id @default(uuid())
  /// Default monthly limit in minor currency units (cents); used for any month
  /// without a BudgetPeriod override.
  monthlyLimit Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Scope: a specific subcategory...
  subcategoryId String?
  subcategory   Subcategory?         @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  /// ...or a whole category (subcategoryId is then null)
  category      TransactionCategory?

  periods BudgetPeriod[]

  @@unique([userId, subcategoryId])
  @@unique([userId, category])
  @@index([userId])
}

/// A per-month override of a budget's limit, so the same budget can be e.g.
/// €300 for the May cycle and €500 for June. `period` is the financial-month
/// label "YYYY-MM" (the same labelling the dashboard uses). A month with no row
/// falls back to Budget.monthlyLimit.
model BudgetPeriod {
  id       String @id @default(uuid())
  /// Financial-month label, e.g. "2026-06"
  period   String
  /// Limit for this month in minor currency units (cents)
  limit    Int
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, period])
  @@index([budgetId])
}
