# Postgres from docker-compose.yml (host port 5433 to avoid clashing with a
# natively installed Postgres on 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/finance_tracker"

# Secret for signing JWT access tokens. Generate one with: openssl rand -hex 32
JWT_SECRET="replace-me-with-a-long-random-string"

# Optional: token from @BotFather for the Telegram quick-capture bot.
# Leave unset to disable the bot entirely.
# TELEGRAM_BOT_TOKEN=""

# --- Import categorizer -----------------------------------------------------
# Which categorizer runs on CSV imports for rows no rule already matched:
#   anthropic  hosted Claude (best accuracy; sends descriptions to Anthropic)
#   ollama     local model via Ollama (private; nothing leaves the machine)
#   heuristic  name-match only; everything else goes to the review queue
# Leave unset to auto-pick: Claude if ANTHROPIC_API_KEY is set, else heuristic.
# CATEGORIZER="anthropic"

# Hosted (Claude). Setting the key alone is enough to turn the LLM on.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"

# Local (Ollama). Requires Ollama running with the model pulled:
#   ollama pull llama3.1   (then set CATEGORIZER="ollama")
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.1"

# Confidence at/above which a prediction is auto-applied (default 0.7).
# DEFAULT_CATEGORIZATION_THRESHOLD="0.7"
